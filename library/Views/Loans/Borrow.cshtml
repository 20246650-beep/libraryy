@model BorrowForm
@{
    ViewData["Title"] = "Borrow a book";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <h1 class="h4 fw-bold text-dark">Borrow a book</h1>
                    <p class="text-muted small mb-0">Fill out the details below to log a new loan entry.</p>
                </div>

                <form asp-action="Borrow" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="MemberId" class="form-label fw-semibold">Member</label>
                        <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select rounded-3">
                            <option value="">(choose a member)</option>
                        </select>
                        <span asp-validation-for="MemberId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BookId" class="form-label fw-semibold">Book</label>
                        <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select rounded-3">
                            <option value="">(choose a book)</option>
                        </select>
                        <span asp-validation-for="BookId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DaysAllowed" class="form-label fw-semibold">Days allowed</label>
                        <input asp-for="DaysAllowed" class="form-control rounded-3" />
                        <span asp-validation-for="DaysAllowed" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary rounded-3 py-2 fw-semibold">Borrow</button>
                        <a asp-action="Index" class="btn btn-link text-muted text-decoration-none">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}