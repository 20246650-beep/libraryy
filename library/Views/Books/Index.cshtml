@model List<Book>
@{
    ViewData["Title"] = "Books";
}

<div class="p-4 mb-4 rounded-4 shadow-sm bg-white border">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="mb-1 fw-bold text-dark"><i class="bi bi-journal-bookmark-fill text-primary me-2"></i>Books Catalogue</h1>
            <p class="text-muted mb-0">@Model.Count books in the catalogue</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> Add a book
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="text-end py-3 ps-4" style="width:5rem">#</th>
                    <th class="py-3">Title</th>
                    <th class="py-3">Category</th>
                    <th class="text-end py-3">Price</th>
                    <th class="py-3 pe-4 text-end" style="width:12rem">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td class="text-end ps-4 fw-bold text-muted">@book.BookId</td>
                        <td class="fw-semibold text-dark">@book.Title</td>
                        <td><span class="badge text-bg-secondary rounded-pill px-3 py-2">@(book.Category ?? "—")</span></td>
                        <td class="text-end fw-semibold text-success">@(book.Price?.ToString("N2") ?? "—")</td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-1">Edit</a>
                            <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>