@model Note
@{
    ViewData["Title"] = "Add a note";
}

<h1 class="mb-3">Add a note</h1>

<form asp-action="Create" method="post" class="card card-body shadow-sm border-0 rounded-4" style="max-width:36rem">
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Body" class="form-label"></label>
        <textarea asp-for="Body" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary rounded-pill px-4">Save</button>
        <a asp-action="Index" class="btn btn-link text-decoration-none">Cancel</a>
    </div>
</form>