@model Note
@{
    ViewData["Title"] = "Delete a note";
}

<h1 class="mb-3">Delete a note</h1>

<div class="card card-body shadow-sm border-0 rounded-4" style="max-width:36rem">
    <p class="fw-semibold">Are you sure you want to delete this note?</p>
    <dl class="row mb-3">
        <dt class="col-4">Title</dt>
        <dd class="col-8">@Model.Title</dd>
        <dt class="col-4">Body</dt>
        <dd class="col-8">@(Model.Body ?? "—")</dd>
        <dt class="col-4">Created On</dt>
        <dd class="col-8">@Model.CreatedOn</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.NoteId" method="post">
        <button type="submit" class="btn btn-danger rounded-pill px-4">Delete</button>
        <a asp-action="Index" class="btn btn-link text-decoration-none">Cancel</a>
    </form>
</div>