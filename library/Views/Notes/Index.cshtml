@model List<Note>
@{
    ViewData["Title"] = "Notepad";
}

<div class="p-4 mb-4 rounded-4 shadow-sm bg-white border">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="mb-1 fw-bold text-dark"><i class="bi bi-journal-text text-primary me-2"></i>Library Notepad</h1>
            <p class="text-muted mb-0">@Model.Count notes recorded</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> Add a note
        </a>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var note in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-4 bg-white">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="text-muted small fw-bold">ID #@note.NoteId</span>
                            <span class="badge bg-light text-dark border">@note.CreatedOn</span>
                        </div>
                        <h4 class="card-title fw-bold text-dark mb-2">@note.Title</h4>
                        <p class="card-text text-muted mb-4">@(note.Body ?? "—")</p>
                    </div>
                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Edit" asp-route-id="@note.NoteId" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Edit</a>
                        <a asp-action="Delete" asp-route-id="@note.NoteId" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>