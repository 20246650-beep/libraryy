@model Member
@{
    ViewData["Title"] = "Delete a Member";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <h1 class="h4 fw-bold text-dark mb-3">Delete a member</h1>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 shadow-sm rounded-3 py-3 px-4 mb-3" role="alert">
                @ViewBag.Error
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="card-body">
                <p class="text-muted mb-3">Are you sure you want to delete this member? This action cannot be undone.</p>

                <dl class="row mb-4 bg-light p-3 rounded-3">
                    <dt class="col-4 text-muted fw-semibold">Full Name</dt>
                    <dd class="col-8 text-dark mb-2">@Model.FullName</dd>

                    <dt class="col-4 text-muted fw-semibold">Email</dt>
                    <dd class="col-8 text-dark mb-2">@(Model.Email ?? "—")</dd>

                    <dt class="col-4 text-muted fw-semibold">Type</dt>
                    <dd class="col-8 text-dark mb-0">@Model.MemberType</dd>
                </dl>

                <form asp-action="Delete" asp-route-id="@Model.MemberId" method="post" class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger rounded-3 px-4 fw-semibold">Delete</button>
                    <a asp-action="Index" class="btn btn-light rounded-3 text-muted">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>