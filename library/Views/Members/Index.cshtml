@model List<Member>
@{
    ViewData["Title"] = "Members Directory";
}

<!-- Header Section -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-people-fill me-2 text-primary"></i>Members Directory
            </h1>
            <p class="text-muted mb-0">@Model.Count members registered</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-semibold">
            <i class="bi bi-person-plus-fill me-1"></i> Add a member
        </a>
    </div>
</div>

<!-- Table Section -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark text-uppercase fs-7">
                <tr>
                    <th class="ps-4">#</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Type</th>
                    <th class="text-end">Books out</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model)
                {
                    <tr>
                        <td class="ps-4 text-muted fw-semibold">@member.MemberId</td>
                        <td class="fw-semibold text-dark">@member.FullName</td>
                        <td class="text-muted">@(member.Email ?? "—")</td>

                        @* TYPE COLUMN: Places each badge inside its matching row under Type *@
                        <td>
                            <span class="badge px-3 py-2 rounded-pill @(member.MemberType == "Faculty" ? "bg-danger" : member.MemberType == "Student" ? "bg-success" : "bg-info text-white")">
                                @member.MemberType
                            </span>
                        </td>

                        <td class="text-end fw-medium">@member.OpenLoans</td>
                        <td class="text-end pe-4">
                            <div class="btn-group gap-1" role="group">
                                <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Edit</a>
                                <a asp-action="Details" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-primary rounded-pill px-3">Loans</a>
                                <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>