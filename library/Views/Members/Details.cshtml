@model MemberDetails
@{
    ViewData["Title"] = Model.Member.FullName;
}

<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-light">
    <div class="card-body">
        <h1 class="h3 fw-bold text-dark mb-1">@Model.Member.FullName</h1>
        <p class="text-muted mb-0">
            <span class="badge bg-secondary me-2">@Model.Member.MemberType</span>
            <span>@(Model.Member.Email ?? "no email")</span>
        </p>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 fw-bold text-dark mb-0">Loans</h2>
</div>

@if (Model.Loans.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white mb-4">
        <p class="text-muted mb-0">This member has never borrowed a book.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">Book</th>
                        <th>Loaned</th>
                        <th>Returned</th>
                        <th class="pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model.Loans)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">@loan.BookTitle</td>
                            <td class="text-muted">@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                            <td class="text-muted">@(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="pe-4">
                                <span class="badge px-3 py-2 rounded-pill @(loan.Status == "Overdue" ? "bg-danger-subtle text-danger border border-danger-subtle" : loan.Status == "Out" ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : "bg-success-subtle text-success border border-success-subtle")">
                                    @loan.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">← Back to members</a>